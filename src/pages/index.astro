</BaseLayout>

<style>
  .hero-content {
    padding: 2rem 0 2.5rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.32rem 0.75rem 0.32rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 1.1rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.3;
    color: white;
  }

  .role {
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }

  .intro {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 56ch;
  }

  section {
    margin-bottom: 2.5rem;
    opacity: 0;
    transform: translateY(14px);
  }

  section.in-view {
    animation: reveal 0.5s ease forwards;
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    section {
      opacity: 1;
      transform: none;
    }
    section.in-view {
      animation: none;
    }
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    margin-top: 0;
    color: white;
  }

  p {
    margin-bottom: 0.5rem;
    color: #e0e0e0;
  }

  ul {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
    color: #e0e0e0;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    color: #86efac;
  }

  strong {
    font-weight: 600;
    color: white;
  }

  .michigan-pride {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  .block-m {
    display: inline-block;
    background: #FFCB05;
    color: #00274C;
    font-weight: 900;
    font-size: 0.7rem;
    width: 1.1rem;
    height: 1.1rem;
    line-height: 1.1rem;
    text-align: center;
    border-radius: 2px;
    font-family: 'Arial Black', sans-serif;
  }

  .go-blue {
    color: #FFCB05;
    font-weight: 600;
    font-size: 0.7rem;
  }
</style>

<noscript>
  <style is:global>
    section { opacity: 1 !important; transform: none !important; }
  </style>
</noscript>

<script>
  const sections = document.querySelectorAll('main section');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15 }
  );
  sections.forEach((section) => observer.observe(section));
</script>
