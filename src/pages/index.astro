---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Brendan Palkowski">
  <div class="hero-content">
    <span class="status-badge"><span class="status-dot"></span>Grand Rapids, MI &middot; 28</span>
    <h1>Brendan Palkowski</h1>
    <p class="role">$ systems engineer &mdash; platform &amp; infra</p>
    <p class="intro">
      I design the systems other teams ship on: Kubernetes APIs, GitOps, multi-cloud infrastructure. Currently at First American.
    </p>
    <p class="links">
      <a href="https://github.com/bpalko" target="_blank" rel="noreferrer">GitHub</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="https://www.linkedin.com/in/brendan-palkowski/">LinkedIn</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="https://x.com/b_palkowski" target="_blank" rel="noreferrer">X</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="/resume">Resume</a>
    </p>
    <p class="michigan-line">
      University of Michigan
      <span class="michigan-pride">
        <span class="block-m">M</span>
        <span class="go-blue">Go Blue!</span>
      </span>
    </p>
  </div>
</BaseLayout>

<style>
  .hero-content {
    padding: 2rem 0 2.5rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.32rem 0.75rem 0.32rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 1.1rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    line-height: 1.3;
    color: white;
  }

  .role {
    color: var(--accent);
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }

  .intro {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--text-dim);
    max-width: 56ch;
    margin-bottom: 1.15rem;
  }

  .links {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 0.85rem;
  }

  .links .dot {
    margin: 0 0.45rem;
    color: var(--text-dim);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    color: #86efac;
  }

  .michigan-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-dim);
  }

  .michigan-pride {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .block-m {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #FFCB05;
    color: #00274C;
    font-weight: 900;
    font-size: 0.78rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 3px;
    font-family: 'Arial Black', sans-serif;
    line-height: 1;
  }

  .go-blue {
    color: #FFCB05;
    font-weight: 600;
    font-size: 0.88rem;
  }
</style>
