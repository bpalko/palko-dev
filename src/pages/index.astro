  <section>
    <h2>Certifications:</h2>
      <p>Certified Kubernetes Application Developer (CKAD) - Expiration: December 2024</p>
  </section>

  <section>
    <h2>Education:</h2>
      <p><strong>University of Michigan</strong>
        <span class="michigan-pride">
         <span class="block-m">M</span>
          <span class="go-blue">Go Blue!</span>
        </span>
        -- Bachelor of Science in Information Science
