---
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/palko.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root {
        --font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
        --bg: #0a0a0a;
        --border: rgba(255, 255, 255, 0.1);
        --text-color: #f5f5f5;
        --text-dim: #b3b3b3;
        --accent: #4ade80;
        --accent-soft: rgba(74, 222, 128, 0.14);
        --accent-glow: rgba(74, 222, 128, 0.32);
        --page-pad-x: 2rem;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-family);
        color: var(--text-color);
        background-color: var(--bg);
        line-height: 1.65;
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      body {
        position: relative;
        min-height: 100vh;
        overflow-x: clip;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
          radial-gradient(640px 420px at 12% 8%, var(--accent-soft), transparent 65%),
          radial-gradient(520px 380px at 92% 85%, rgba(255, 255, 255, 0.05), transparent 70%),
          var(--bg);
      }

      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 1.5rem var(--page-pad-x) 3rem;
      }

      .container.wide {
        max-width: 8.5in;
        padding: 1.5rem 1rem 3rem;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        width: 100%;
        background:
          linear-gradient(90deg, rgba(74, 222, 128, 0.1), transparent 35%, transparent 65%, rgba(74, 222, 128, 0.1)),
          linear-gradient(180deg, rgba(13, 18, 15, 0.92), rgba(10, 10, 10, 0.86));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      header::after {
        content: '';
        display: block;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--accent-glow), transparent);
      }

      .header-inner {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 1.25rem var(--page-pad-x);
        position: relative;
      }

      .logo {
        display: inline-block;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-color);
        text-decoration: none;
      }

      .logo:hover {
        color: var(--accent);
      }

      .nav-toggle-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      .nav-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-color);
        cursor: pointer;
        border-radius: 4px;
      }

      .nav-toggle:hover,
      .nav-toggle-input:focus-visible + .nav-toggle,
      .nav-toggle-input:checked + .nav-toggle {
        border-color: rgba(74, 222, 128, 0.45);
        color: var(--accent);
      }

      .nav-toggle-bars {
        display: block;
        width: 1rem;
        height: 1px;
        background: currentColor;
        box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: flex-end;
      }

      nav a {
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.9rem;
      }

      nav a:hover {
        color: var(--accent);
      }

      main {
        min-height: 60vh;
      }

      img,
      iframe,
      video {
        max-width: 100%;
      }

      @media (max-width: 720px) {
        :root {
          --page-pad-x: 1rem;
        }

        .header-inner {
          padding: 0.85rem var(--page-pad-x);
        }

        .nav-toggle {
          display: inline-flex;
          margin-left: auto;
          z-index: 2;
        }

        nav {
          display: none;
          position: absolute;
          top: calc(100% + 0.35rem);
          left: var(--page-pad-x);
          right: var(--page-pad-x);
          z-index: 20;
          flex-direction: column;
          gap: 0;
          border: 1px solid var(--border);
          background: rgba(10, 10, 10, 0.97);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border-radius: 6px;
          overflow: hidden;
          box-shadow: 0 16px 40px -18px rgba(0, 0, 0, 0.85);
        }

        .nav-toggle-input:checked ~ nav {
          display: flex;
        }

        nav a {
          padding: 0.75rem 0.9rem;
          border-bottom: 1px solid var(--border);
          font-size: 0.88rem;
        }

        nav a:last-child {
          border-bottom: none;
        }

        .container {
          padding: 1.15rem var(--page-pad-x) 2.5rem;
        }

        .container.wide {
          padding: 1.15rem 0.75rem 2.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">palko.dev</a>
        <input
          class="nav-toggle-input"
          type="checkbox"
          id="nav-toggle"
          aria-controls="site-nav"
        />
        <label class="nav-toggle" for="nav-toggle" aria-label="Menu">
          <span class="nav-toggle-bars" aria-hidden="true"></span>
        </label>
        <nav id="site-nav">
          <a href="/">Home</a>
          <a href="/resume">Resume</a>
          <a href="/blog">Blog</a>
          <a href="/bookshelf">Bookshelf</a>
          <a href="/bar-cart">Bar Cart</a>
          <a href="/music">Music</a>
        </nav>
      </div>
    </header>
    <div class:list={['container', { wide }]}>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
