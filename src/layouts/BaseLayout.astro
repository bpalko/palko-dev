---
interface Props {
  title: string;
  description?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/palko.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root {
        --font-family: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
        --bg: #0a0a0a;
        --border: rgba(255, 255, 255, 0.1);
        --text-color: #f5f5f5;
        --text-dim: #b3b3b3;
        --accent: #4ade80;
        --accent-soft: rgba(74, 222, 128, 0.14);
        --accent-glow: rgba(74, 222, 128, 0.32);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--font-family);
        color: var(--text-color);
        background-color: var(--bg);
        line-height: 1.65;
        font-size: 16px;
      }

      body {
        position: relative;
        min-height: 100vh;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
          radial-gradient(640px 420px at 12% 8%, var(--accent-soft), transparent 65%),
          radial-gradient(520px 380px at 92% 85%, rgba(255, 255, 255, 0.05), transparent 70%),
          var(--bg);
      }

      .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 1.5rem 2rem 3rem;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        width: 100%;
        background:
          linear-gradient(90deg, rgba(74, 222, 128, 0.1), transparent 35%, transparent 65%, rgba(74, 222, 128, 0.1)),
          linear-gradient(180deg, rgba(13, 18, 15, 0.92), rgba(10, 10, 10, 0.86));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      header::after {
        content: '';
        display: block;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--accent-glow), transparent);
      }

      .header-inner {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 1.25rem 2rem;
      }

      .logo {
        display: inline-block;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-color);
        text-decoration: none;
      }

      .logo:hover {
        color: var(--accent);
      }

      nav {
        display: flex;
        gap: 1.5rem;
      }

      nav a {
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.9rem;
      }

      nav a:hover {
        color: var(--accent);
      }

      main {
        min-height: 60vh;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">palko.dev</a>
        <nav>
          <a href="/">Home</a>
          <a href="/blog">Blog</a>
          <a href="/bookshelf">Bookshelf</a>
          <a href="/bar-cart">Bar Cart</a>
        </nav>
      </div>
    </header>
    <div class="container">
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
